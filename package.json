{
  "name": "cv-tailor",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "boundaries": "node scripts/boundaries.mjs",
    "check": "pnpm typecheck && pnpm boundaries",
    "dev": "pnpm --parallel --filter @cv-tailor/api --filter @cv-tailor/web --filter @cv-tailor/renderer dev",
    "compose": "docker compose up --build",
    "compose:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build"
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "dependency-cruiser": "^18.7.2"
  }
}
