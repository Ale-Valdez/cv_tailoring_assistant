# Copiar a `.env`. api no arranca si faltan las obligatorias.
# gpt-6-luna tiene salida estructurada. Se puede cambiar por otro identificador de OpenAI.
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
OPENAI_API_KEY=
# gpt-6-luna solo acepta la temperatura por defecto: dejar la línea vacía.
# Otros identificadores pueden fijar un número (por ejemplo 0).
LLM_TEMPERATURE=

# PostgreSQL (ADR-013). Este URL es para procesos en el host (puerto publicado en el override de desarrollo).
# Dentro de Compose, el servicio `api` usa el host `db` y no lee este URL.
POSTGRES_USER=cv_tailor
POSTGRES_PASSWORD=cv_tailor
POSTGRES_DB=cv_tailor
DATABASE_URL=postgresql://cv_tailor:cv_tailor@127.0.0.1:5432/cv_tailor

# LangSmith (ADR-007, ADR-019). Sin código de observabilidad: LangChain traza si el flag está en true.
# Para apagarlo, dejar LANGSMITH_TRACING=false. Con true hacen falta LANGSMITH_API_KEY y LANGSMITH_PROJECT,
# y el contenido enviado al modelo queda guardado en LangSmith. Los datos de contacto no se envían.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cv-tailor
# LANGSMITH_ENDPOINT=

# URL interna de api para el rewrite de Next en `pnpm dev`. Sin barra final.
# Compose fija http://api:3001 en el servicio `web` (en la imagen de producción, también en el build).
API_INTERNAL_URL=http://127.0.0.1:3001

# URL del renderer para api cuando corre en el host. Sin barra final.
# Compose fija http://renderer:3002 en el servicio `api`.
RENDERER_URL=http://127.0.0.1:3002

# Directorio de los PDF exportados. Compose lo reemplaza por /data/files (volumen `files`).
FILES_DIR=.data/files

# Puertos publicados en el host. Dentro de la red de Compose no cambian.
WEB_PORT=3000
API_PORT=3001
RENDERER_PORT=3002
DB_PORT=5432
